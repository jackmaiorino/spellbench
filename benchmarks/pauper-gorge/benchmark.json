  "format": "pauper-bo1",
  "pairing": "rotating_pool",
  "engine": {
    "name": "gorge",
    "command": [
      "${GORGE_SPELLBENCH_ENV}",
      "-registry",
      "${GORGE_REGISTRY}",
      "-registry-sha256",
      "${GORGE_REGISTRY_SHA256}",
      "-auto-pay",
      "-search"
    ]
  },
  "deck_pool": [
    "Wildfire",
    "Rally",
    "Spy",
    "Burn",
    "CawGates"
  ],
  "pairs_per_deck": 4,
  "stats_seed": 20261002,
  "extensions": [
    "x_gorge_view_v1",
    "x_gorge_search_v1"
  ],
