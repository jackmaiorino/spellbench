  },
  "workers": 8,
  "time_control": {
    "startup_ms": 120000,
    "game_start_ms": 60000,
    "bank_ms": 600000,
    "increment_ms": 2000,
    "max_decision_ms": 60000,
    "engine_step_ms": 120000
  },
  "limits": {
    "max_decisions": 10000,
    "max_steps": 100000,
    "max_seat_decisions_per_turn": 500,
    "max_seat_decisions_per_game": 4999,
    "max_seat_steps_per_game": 49999
